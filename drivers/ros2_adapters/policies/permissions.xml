<?xml version="1.0" encoding="UTF-8"?>
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="http://www.omg.org/spec/DDS-SECURITY/20170801/omg_shared_ca_permissions.xsd">
  <permissions>

    <!-- 1. Bipedal HAL Adapter Grant -->
    <grant name="bipedal_hal_node_grant">
      <subject_name>CN=bipedal_hal_node,O=Arcstone,ST=Texas,C=US</subject_name>
      <validity>
        <not_before>2026-01-01T00:00:00</not_before>
        <not_after>2036-01-01T00:00:00</not_after>
      </validity>
      <rules>
        <domains>
          <id>0</id>
        </domains>
        <allow_rule>
          <publish>
            <topics>
              <topic>rt/bipedal/cmd_vel</topic>
              <topic>rt/bipedal/joint_targets</topic>
            </topics>
          </publish>
          <subscribe>
            <topics>
              <topic>rt/arcstone/uedo_decision</topic>
              <topic>rt/bipedal/cmd_vel_raw</topic>
            </topics>
          </subscribe>
        </allow_rule>
        <default>DENY</default>
      </rules>
    </grant>

    <!-- 2. Submersible HAL Adapter Grant -->
    <grant name="submersible_hal_node_grant">
      <subject_name>CN=submersible_hal_node,O=Arcstone,ST=Texas,C=US</subject_name>
      <validity>
        <not_before>2026-01-01T00:00:00</not_before>
        <not_after>2036-01-01T00:00:00</not_after>
      </validity>
      <rules>
        <domains>
          <id>0</id>
        </domains>
        <allow_rule>
          <publish>
            <topics>
              <topic>rt/submersible/thruster_thrust_setpoints</topic>
              <topic>rt/submersible/ballast_safety_lock</topic>
            </topics>
          </publish>
          <subscribe>
            <topics>
              <topic>rt/arcstone/uedo_submersible_decision</topic>
              <topic>rt/submersible/thruster_thrust_setpoints_raw</topic>
            </topics>
          </subscribe>
        </allow_rule>
        <default>DENY</default>
      </rules>
    </grant>

    <!-- 3. Authorized Control-Plane Decision Publisher Grant -->
    <grant name="control_plane_decision_grant">
      <subject_name>CN=uedo_control_plane,O=Arcstone,ST=Texas,C=US</subject_name>
      <validity>
        <not_before>2026-01-01T00:00:00</not_before>
        <not_after>2036-01-01T00:00:00</not_after>
      </validity>
      <rules>
        <domains>
          <id>0</id>
        </domains>
        <allow_rule>
          <publish>
            <topics>
              <topic>rt/arcstone/uedo_decision</topic>
              <topic>rt/arcstone/uedo_submersible_decision</topic>
            </topics>
          </publish>
        </allow_rule>
        <default>DENY</default>
      </rules>
    </grant>

    <!-- 4. Untrusted Autonomous Agent / Planner Grant -->
    <grant name="untrusted_agent_grant">
      <subject_name>CN=autonomous_planner,O=Arcstone,ST=Texas,C=US</subject_name>
      <validity>
        <not_before>2026-01-01T00:00:00</not_before>
        <not_after>2036-01-01T00:00:00</not_after>
      </validity>
      <rules>
        <domains>
          <id>0</id>
        </domains>
        <allow_rule>
          <!-- Gated exclusively to unprivileged raw proposal topics -->
          <publish>
            <topics>
              <topic>rt/bipedal/cmd_vel_raw</topic>
              <topic>rt/submersible/thruster_thrust_setpoints_raw</topic>
            </topics>
          </publish>
        </allow_rule>
        <default>DENY</default>
      </rules>
    </grant>

  </permissions>
</dds>
